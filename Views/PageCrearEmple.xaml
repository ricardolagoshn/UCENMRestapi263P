<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UCENMRestapi263P.Views.PageCrearEmple"
             Title="Nuevo empleado">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="14">

                <!-- Foto -->
                <Border WidthRequest="140" HeightRequest="140"
                        HorizontalOptions="Center"
                        StrokeThickness="0"
                        BackgroundColor="#EEEEEE">
                    <Border.StrokeShape>
                        <Ellipse />
                    </Border.StrokeShape>
                    <Image x:Name="imgFoto"
                           Aspect="AspectFill"
                           WidthRequest="140" HeightRequest="140" />
                </Border>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Button Text="Tomar foto" Clicked="OnTomarFoto" />
                    <Button Text="Galería" Clicked="OnSeleccionarFoto" />
                </HorizontalStackLayout>

                <!-- Datos -->
                <Label Text="Nombre" FontAttributes="Bold" />
                <Entry x:Name="txtNombre" Placeholder="Nombre" MaxLength="100" />

                <Label Text="Apellidos" FontAttributes="Bold" />
                <Entry x:Name="txtApellidos" Placeholder="Apellidos" MaxLength="100" />

                <Label Text="Edad" FontAttributes="Bold" />
                <Entry x:Name="txtEdad" Placeholder="Edad" Keyboard="Numeric" MaxLength="3" />

                <Button x:Name="btnGuardar"
                        Text="Guardar"
                        Margin="0,10,0,0"
                        Clicked="OnGuardar" />
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator x:Name="cargando"
                           IsRunning="False"
                           IsVisible="False"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
