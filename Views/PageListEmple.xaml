<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:UCENMRestapi263P.Converters"
             xmlns:models="clr-namespace:UCENMRestapi263P.Models"
             x:Class="UCENMRestapi263P.Views.PageListEmple"
             Title="Empleados">


    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:Base64ToImageConverter x:Key="Base64ToImage" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Nuevo" Clicked="OnNuevoEmpleado" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*">
        <RefreshView x:Name="refreshView" Refreshing="OnRefreshing">
            <CollectionView x:Name="listaEmpleados"
                            SelectionMode="Single"
                            SelectionChanged="OnEmpleadoSeleccionado"
                            Margin="10">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <Label Text="No hay empleados para mostrar"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray"
                           Margin="0,40,0,0" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Empleado">
                        <Border Padding="10"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="70,*" ColumnSpacing="12">
                                <!-- Foto circular convertida desde Base64 -->
                                <Border Grid.Column="0"
                                        WidthRequest="64" HeightRequest="64"
                                        StrokeThickness="0"
                                        BackgroundColor="#EEEEEE"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <Ellipse />
                                    </Border.StrokeShape>
                                    <Image Source="{Binding Foto, Converter={StaticResource Base64ToImage}}"
                                           Aspect="AspectFill"
                                           WidthRequest="64" HeightRequest="64" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="2">
                                    <Label Text="{Binding NombreCompleto}"
                                           FontSize="17"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding Edad, StringFormat='Edad: {0} años'}"
                                           FontSize="14"
                                           TextColor="Gray" />
                                    <Label Text="{Binding Id, StringFormat='ID: {0}'}"
                                           FontSize="12"
                                           TextColor="Gray" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator x:Name="cargando"
                           IsRunning="False"
                           IsVisible="False"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>

</ContentPage>
